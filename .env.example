# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=production

# Deployment environment. Leave UNSET locally: it is derived from NODE_ENV, and
# anything that isn't production resolves to 'local', which suppresses every
# outbound side effect (no cron jobs, no email, no IMAP polling, Stripe forced to
# test mode). Set APP_ENV=staging on the staging deployment. See server/_core/appEnv.ts.
# APP_ENV=staging

# ⚠️ Opt-in override that RE-ENABLES crons and real email outside production.
# Only set this when DATABASE_URL points at the Docker test DB (`pnpm testdb:up`)
# and you actually intend to send. Never set it in a shell holding prod credentials.
# ALLOW_LOCAL_SIDE_EFFECTS=true

# Base URL for every client-facing link in emails. Must be set on the Railway
# service; server/lib/appUrl.ts falls back to the production domain if it is missing.
VITE_APP_URL=https://your-domain.com
VITE_APP_ID=
COMPANY_TIMEZONE=America/Denver

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=mysql://user:password@host:3306/dbname

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string
OAUTH_SERVER_URL=
OWNER_OPEN_ID=

# ── Stripe (live) ─────────────────────────────────────────────────────────────
STRIPE_TEST_MODE=false
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...

# ── Stripe (test) — set STRIPE_TEST_MODE=true to use these instead ────────────
STRIPE_TEST_SECRET_KEY=sk_test_...
STRIPE_TEST_WEBHOOK_SECRET=whsec_...
VITE_STRIPE_TEST_PUBLISHABLE_KEY=pk_test_...

# ── Cloudflare R2 (file storage) ─────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# ── Email (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Calendly ─────────────────────────────────────────────────────────────────
CALENDLY_API_TOKEN=
CALENDLY_WEBHOOK_SIGNING_KEY=

# ── Feature Flags ────────────────────────────────────────────────────────────
# Set to false to stop all outbound check-in emails (cron). UI and data are unaffected.
# Toggle back to true (or remove the variable) to re-enable.
CHECKIN_ENABLED=true

# ── Logging (optional) ───────────────────────────────────────────────────────
LOG_LEVEL=info
SERVICE_NAME=health-coach-protocol
DISABLE_CONSOLE_LOGS=false
# DATADOG_API_KEY=
# LOGGLY_TOKEN=
